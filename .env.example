# ── KumbhAnna Production Environment Variables ────────────────
# Copy this file, fill in real values, and set as environment variables.
# NEVER commit a filled-in version of this file.

# JWT — generate a strong random secret (min 32 chars)
# Example: openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars

# Admin account — created automatically on first startup
ADMIN_EMAIL=admin@kumbhanna.in
ADMIN_PASSWORD=ReplaceWithStrongPassword@2025
ADMIN_NAME=Admin

# Twilio WhatsApp — get from https://console.twilio.com
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_twilio_auth_token_here
TWILIO_FROM=whatsapp:+14155238886
